// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "auto_install_extensions": {
    "ayu-themes-glass": true,
    "biome": true,
    "comment": true,
    "django": true,
    "dockerfile": true,
    "editorconfig": true,
    "env": true,
    "git-firefly": true,
    "github-actions": true,
    "graphql": true,
    "html": true,
    "ini": true,
    "jinja2": true,
    "jq": true,
    "json5": true,
    "jsonl": true,
    "just": true,
    "latex": true,
    "log": true,
    "lua": true,
    "make": true,
    "mermaid": true,
    "python-requirements": true,
    "rainbow-csv": true,
    "ruby": true,
    "rumdl": true,
    "sql": true,
    "svelte": true,
    "tokyo-night": true,
    "toml": true,
    "tree-sitter-query": true,
    "typst": true,
    "vue": true,
    "xml": true,
    "zig": true,
  },
  "diff_view_style": "unified",
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
      // pi-acp starts this instead of `pi`, so Zed's pi runs inside nono
      // (bin/nonopi, config/nono/profiles/pi.local.json).
      "env": {
        "PI_ACP_PI_COMMAND": "/Users/alejandrogiacometti/.bin/nonopi",
      },
    },
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "feature_flags": {
    "tabular-data-preview": "on",

    "notebooks": "on",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "load_direnv": "direct",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "env": {
      "EDITOR": "zed --wait",
    },
    "dock": "right",
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
  },
  "file_scan_inclusions": [".todo", ".envrc"],
  "format_on_save": "on",
  "theme": "Ayu Glass Mirage",
  "buffer_font_family": "Iosevka Nerd Font",
  "buffer_font_size": 13,
  "lsp": {
    "ty": {
      "initialization_options": {
        "experimental": {
          "useUv": "scripts",
        },
      },
    },
  },
  "languages": {
    "Python": {
      "language_servers": ["ruff", "ty", "!basedpyright"],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
    "Markdown": {
      "soft_wrap": "none",
      "formatter": {
        "language_server": {
          "name": "rumdl",
        },
      },
    },
  },
}
